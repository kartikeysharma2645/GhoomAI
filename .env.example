# GhoomAI — environment template (placeholders only, no secrets).
# Copy to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored. Never commit real keys.

# App environment: development | test | production
NODE_ENV=development

# Public base URL of the running app (no secrets here)
APP_BASE_URL=http://localhost:3000

# Server-only SerpApi key. Read ONLY via process.env.SERPAPI_KEY on the server.
# Required for all live SerpApi-backed functionality (search, planning research,
# verification, discovery). NEVER prefix with NEXT_PUBLIC_. Leave empty until a key is available.
SERPAPI_KEY=1bb6fa18cecc7950eea5bf5b4c014342072958ec4475be04db2ef1e6789b5936

# Reserved for a future vision provider adapter.
# Vision provider configuration is optional. Without a configured provider,
# live image recognition honestly reports VISION_NOT_CONFIGURED.
# NEVER prefix with NEXT_PUBLIC_.
# VISION_PROVIDER=your_provider_name_here
# VISION_API_KEY=your_key_here

# Server-only OpenAI API key for the vision provider adapter.
# Read ONLY via process.env.OPENAI_API_KEY on the server.
# NEVER prefix with NEXT_PUBLIC_. Never commit a real key.
# OPENAI_API_KEY=your_key_here
# Optional vision model override (default: gpt-4o-mini).
# VISION_MODEL=gpt-4o-mini
