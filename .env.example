# GhoomAI — environment template (placeholders only, no secrets).
# Copy to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored. Never commit real keys.

# App environment: development | test | production
NODE_ENV=development

# Public base URL of the running app (no secrets here)
APP_BASE_URL=http://localhost:3000

# Server-only SerpApi key. Read ONLY via process.env.SERPAPI_KEY on the server.
# Required for all live SerpApi-backed functionality (search, planning research,
# verification, discovery). NEVER prefix with NEXT_PUBLIC_. Leave empty until a key is available.
SERPAPI_KEY=your_key_here

# Vision provider selection: "openai", "google", or unset for automatic.
# - Unset (default): OpenAI registers when OPENAI_API_KEY is set; Google
#   Cloud Vision registers when GOOGLE_CLOUD_VISION_ENABLED is truthy.
#   Google wins ties because landmark identification is its purpose.
# - "google": Google Cloud Vision only. "openai": OpenAI only.
# NEVER prefix with NEXT_PUBLIC_.
# VISION_PROVIDER=google
#
# Set to 1/true to enable the Google Cloud Vision adapter (uses Application
# Default Credentials — no key value goes here). Leave unset to keep vision
# honestly reporting VISION_NOT_CONFIGURED when nothing is configured.
# GOOGLE_CLOUD_VISION_ENABLED=1
#
# Local ADC setup (run these yourself, once per machine — do NOT commit output):
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project PROJECT_ID  # only if quota errors ask for it
# Production servers typically provide ADC automatically (e.g. workload
# identity); otherwise set GOOGLE_APPLICATION_CREDENTIALS to a local file
# path OUTSIDE the repository. Never commit service-account JSON.

# Server-only OpenAI API key for the vision provider adapter.
# Read ONLY via process.env.OPENAI_API_KEY on the server.
# NEVER prefix with NEXT_PUBLIC_. Never commit a real key.
# OPENAI_API_KEY=your_key_here
# Optional vision model override (default: gpt-4o-mini).
# VISION_MODEL=gpt-4o-mini
